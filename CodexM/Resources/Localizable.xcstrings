          "stringUnit": {
            "state": "translated",
            "value": "The local data operation failed. Check folder permissions and free disk space."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机数据操作失败。请检查目录权限和磁盘空间。"
          }
        }
      }
