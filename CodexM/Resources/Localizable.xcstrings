    "handoff.localHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Context handoff creates a new task with the original request and recent excerpts. It does not transfer the full native history or account credentials."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文接力：在目标账户新建任务，保留原始请求和近期摘录；不会迁移原任务的完整历史或账户凭据。"
          }
        }
      }
