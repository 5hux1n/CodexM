{
  "sourceLanguage": "en",
  "strings": {
    "accessibility.authorization": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能授权"
          }
        }
      }
    },
    "accessibility.compact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Accessibility for window controls."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启辅助功能以管理窗口。"
          }
        }
      }
    },
    "accessibility.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CodexM needs Accessibility permission to focus and manage Codex windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CodexM 需要“辅助功能”权限，以聚焦和管理 Codex 窗口。"
          }
        }
      }
    },
    "accessibility.granted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility is enabled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已开启辅助功能权限"
          }
        }
      }
    },
    "accessibility.missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility is not enabled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未开启辅助功能权限"
          }
        }
      }
    },
    "accessibility.openSettings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统设置"
          }
        }
      }
    },
    "accessibility.optional": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can create, launch and quit accounts without this permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未授权也能创建、启动和退出账户。"
          }
        }
      }
    },
    "accessibility.reauthorizeHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If permission is enabled but not detected after an update, remove the old CodexM entry in Accessibility and add this app again. Local unsigned-release identity can change between builds. Reopen CodexM if macOS requests it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若更新后系统中已开启权限，但此处仍未识别，请在辅助功能列表中移除旧 CodexM，再添加上方路径的应用。当前本地签名版本在更新后可能需要重新授权；若系统要求，请重新打开 CodexM。"
          }
        }
      }
    },
    "accessibility.refresh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Permission"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检测"
          }
        }
      }
    },
    "accessibility.request": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request Permission"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求权限"
          }
        }
      }
    },
