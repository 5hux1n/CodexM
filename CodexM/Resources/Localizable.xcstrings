    "native.error.busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The target account or its data is in use. Stop its Codex windows and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标账户或其数据仍在使用中，请停止目标 Codex 后重试。"
          }
        }
      }
    },
    "native.error.capability": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current official program could not reliably load this task in an isolated test. The target account has not been modified. Use Context Handoff for this task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前官方程序未能在隔离试读中稳定重建此任务，目标账户尚未写入。此任务请使用上下文接力。"
          }
        }
      }
    },
    "native.error.changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task data changed during the operation. Pause the source task and stop the target before retrying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作期间任务数据发生变化，请暂停源任务并停止目标账户后重试。"
          }
        }
      }
    },
    "native.error.conflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The target already contains this task. It will not be overwritten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标账户已存在此任务，不会覆盖。"
          }
        }
      }
    },
    "native.error.diagnostic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native history processing failed at %@ (code: %@). No successful import is claimed. If this happened during compatibility checking, the target was not written."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生历史处理在“%@”阶段失败（代码：%@），未确认导入成功。若发生在兼容性试读阶段，目标账户尚未写入。"
          }
        }
      }
    },
    "native.error.helper": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The official local history loader did not complete verification. The migration record retains recovery information."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "官方本地历史加载未通过验证，迁移记录中保留了恢复信息。"
          }
        }
      }
    },
    "native.error.incompatible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task database or history format is not recognized. The check is based on structure and isolated loading, not an exact version-number match."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务数据库结构或历史格式无法识别。当前检查依据数据结构和隔离试读，不再要求版本号完全一致。"
          }
        }
      }
    },
    "native.error.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Migration data, paths, checksums or available disk space failed validation. No credentials will be copied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "迁移数据、路径、校验和或可用磁盘空间检查未通过，不会复制凭据。"
          }
        }
      }
    },
    "native.error.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This migration needs recovery before further imports. Keep the backup and avoid modifying the target."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此迁移需要先恢复才能再次导入。请保留备份，暂勿修改目标数据。"
          }
        }
      }
    },
    "native.error.rollbackChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The target has changed since import. Rollback was blocked to preserve newer work. The original backup is retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标数据在导入后发生了变化，为保留后续工作已阻止回滚，原始备份仍然保留。"
          }
        }
      }
    },
    "native.error.runtime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to identify the selected official local program. Locate the installed ChatGPT app in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法识别所选官方本地程序，请在设置中重新选择已安装的 ChatGPT。"
          }
        }
      }
    },
    "native.error.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This first version supports unarchived standalone tasks only. Tasks with child tasks, goals, artifacts or dynamic tools need Context Handoff."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一版支持未归档的独立任务。关联子任务、目标、附件或动态工具的任务请使用上下文接力。"
          }
        }
      }
    },
    "native.evidence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d turns and %d history items verified across helper restart."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已验证 %d 轮、%d 个历史条目，重启本地服务后内容一致。"
          }
        }
      }
    },
    "native.import": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import and Open Target"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入并打开目标账户"
          }
        }
      }
    },
    "native.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy the original task and its unredacted history, preserving its ID. The source stays unchanged. Account credentials are excluded. Import uses the official local history loader; continuing with another account still needs verification. Unsupported tasks can use Context Handoff."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制原任务及未经脱敏的完整历史，保留任务 ID，源任务保持不变；不复制登录凭据。由官方本地程序加载历史，跨账户继续执行仍需验证。不支持的任务可切换为上下文接力。"
          }
        }
      }
    },
    "native.launchFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import succeeded, but the target account could not be opened. Click Open Target Account to retry; no reimport is needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务已导入成功，但未能打开目标账户。点击“打开目标账户”重试即可，无需重新导入。"
          }
        }
      }
    },
    "native.mode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handoff method"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接力方式"
          }
        }
      }
    },
    "native.mode.context": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Context Handoff"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文接力"
          }
        }
      }
    },
    "native.mode.native": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native History Import"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生任务迁移"
          }
        }
      }
    },
    "native.next": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After import, the target account opens automatically. Find this task in its task list; no context pasting is needed. Check the history, then manually send a small continuation request. Import verification does not establish cross-account execution compatibility."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入成功后自动打开目标账户，在任务列表中找到这个原任务即可，无需复制或粘贴上下文。先检查历史，再手动发送一条简短的继续指令。导入验证不代表已证明跨账户执行兼容。"
          }
        }
      }
    },
    "native.openTarget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Target Account"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开目标账户"
          }
        }
      }
    },
    "native.paused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have paused this task in the source account and will not run it in both accounts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已暂停源账户中的此任务，不会在两个账户同时继续执行。"
          }
        }
      }
    },
    "native.recent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native imports and recovery"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生迁移记录与恢复"
          }
        }
      }
    },
    "native.recover": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recover Interrupted Import"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复中断的导入"
          }
        }
      }
    },
    "native.recoverConfirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore task data to the backup from before this import? All current task data will first be preserved in a separate recovery folder. Account credentials stay unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将任务数据恢复到本次导入之前的备份？当前任务数据会先完整另存至恢复目录，登录凭据保持不变。"
          }
        }
      }
    },
    "native.recoveryHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No successful native continuation is claimed. The backup and migration record are kept locally. Use rollback if available; interrupted operations require recovery before retrying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前未确认原生续接成功。备份和迁移记录均保存在本机；可用时点击回滚，操作中断时请先恢复再重试。"
          }
        }
      }
    },
    "native.rollback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll Back Import"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回滚本次导入"
          }
        }
      }
    },
    "native.rollbackHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local backup protects the target’s existing task data if import fails. The source task remains unchanged. Rollback requires the target account to be stopped and its history to be unchanged since import. New target activity blocks rollback to protect new work. Credentials are never restored or overwritten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份用于在导入失败时恢复目标账户原有的任务数据，源任务仍然保留。回滚要求目标账户已停止，且任务数据自导入后没有变化。目标产生新数据后会阻止回滚，避免丢失新工作；不会恢复或覆盖登录凭据。"
          }
        }
      }
    },
    "native.stage.compare": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparing history across restart"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重启前后历史对比"
          }
        }
      }
    },
    "native.stage.initialize": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting the official service"
          }
        },
        "zh-Hans": {
