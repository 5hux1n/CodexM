          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在目标账户中打开上方项目目录，新建任务，粘贴并发送已复制的继续指令。本版不自动创建或发送任务，接力包可随时重新打开。"
          }
        }
      }
