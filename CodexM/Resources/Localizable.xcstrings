    "error.accessibilityDenied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS has not granted Accessibility permission to this copy of CodexM. Creating and selecting windows requires this permission. Enable it for the currently running app in System Settings > Privacy & Security > Accessibility."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 尚未授予当前这份 CodexM 辅助功能权限，无法执行新建或精确选择窗口。请在系统设置 → 隐私与安全性 → 辅助功能中授权当前运行的应用；若旧版本已授权，请移除旧条目后重新添加。"
          }
        }
      }
    },
    "error.ambiguousInstance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unrecognized process is already using this account directory. Quit it yourself before launching or deleting the account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
