    "error.handoffDatabase": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the task list. It may be busy or inaccessible; try again shortly. Account launching is unaffected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
